# PetAlert - exemplo de configuração local
# Copie este arquivo para .env e preencha os valores reais.
# Não compartilhe o arquivo .env nem o envie ao Git.

# Banco de dados existente (não cria banco nem tabelas)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petalert
DB_USER=root
DB_PASS=

# Recuperação de senha por SMTP (PHPMailer)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=sua_senha_de_aplicativo
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=seuemail@gmail.com
MAIL_FROM_NAME=PetAlert Proteção Animal

# URL da aplicação no XAMPP
APP_URL=http://localhost/Backand%203%20(1).0/public

# Preencha as chaves apenas se utilizar esses recursos
GEMINI_API_KEY=
GOOGLE_API_KEY=
IDENTIDADE_API_KEY=
IDENTIDADE_API_URL=
IDENTIDADE_MODO=desenvolvimento

# PIX: use somente os dados oficiais da sua instituição
PIX_CHAVE=
PIX_BENEFICIARIO=
PIX_CIDADE=
PIX_PROVIDER=padrao_bacen
PIX_WEBHOOK_SECRET=
